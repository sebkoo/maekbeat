# Maekbeat server environment. Every variable is optional; defaults live in
# src/config.ts. None of these is a secret — real secrets never enter the repo.

# Bind address. Keep loopback for local dev; use 0.0.0.0 inside containers.
HOST=127.0.0.1

# TCP port for the HTTP listener.
PORT=3000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# development | test | production. development also mounts Swagger UI at /docs.
NODE_ENV=development

# Max frames kept per device in the in-process ring buffer (oldest arrival
# evicted first). 1024 at the simulator's 1 s tick is about 17 minutes.
RING_CAPACITY=1024

# Browser origins allowed to read the API: "*" or a comma-separated allowlist.
# The dashboard (apps/web) is always cross-origin against this server.
CORS_ORIGIN=*

# Maximum silence on a dashboard fan-out socket before the server pings it, in
# milliseconds (1000–300000). A ping is a WebSocket control frame, not a
# protocol message, so no client sees it and no schema changes. The default
# assumes the 60 s idle timeout that AWS load balancers and nginx both ship
# with; a dashboard watching a quiet device sends and receives nothing, and
# without this every intermediary in the path closes the socket on a timer.
STREAM_HEARTBEAT_MS=25000

# OTLP/HTTP traces endpoint (C18). Unset — as it is here — the server builds no
# exporter and no batch timer, and every span is non-recording. Setting it is
# the whole on switch; there is no separate enable flag to disagree with it.
# Must be an http(s) URL: a bare host:port is rejected at startup.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# service.name on every exported span.
OTEL_SERVICE_NAME=maekbeat-server

# The commit this build came from. Served as `revision` on /healthz and stamped
# on the container image as org.opencontainers.image.revision, from one build
# argument (infra/server.Dockerfile) — so a container answering with a revision
# its own label does not carry is running something other than what was built.
# Required under NODE_ENV=production and fatal at startup when missing there; a
# working tree is not a commit, so outside production the server reports
# `unidentified` rather than inventing one.
# BUILD_REVISION=
