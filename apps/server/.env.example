# Maekbeat server environment. Every variable is optional; defaults live in
# src/config.ts. None of these is a secret — real secrets never enter the repo.

# Bind address. Keep loopback for local dev; use 0.0.0.0 inside containers.
HOST=127.0.0.1

# TCP port for the HTTP listener.
PORT=3000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# development | test | production. development also mounts Swagger UI at /docs.
NODE_ENV=development

# Max frames kept per device in the in-process ring buffer (oldest arrival
# evicted first). 1024 at the simulator's 1 s tick is about 17 minutes.
RING_CAPACITY=1024

# Browser origins allowed to read the API: "*" or a comma-separated allowlist.
# The dashboard (apps/web) is always cross-origin against this server.
CORS_ORIGIN=*
