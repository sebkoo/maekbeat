# Base URL of the Maekbeat API server (apps/server). Vite exposes only
# VITE_-prefixed variables to the bundle, so nothing else here reaches the
# browser. Holds no secrets — the dashboard talks to an unauthenticated
# development server (apps/server/README.md, "Declared limits").
VITE_API_BASE_URL=http://127.0.0.1:3000
